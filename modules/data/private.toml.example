# Copy this file to ~/.config/nix-config/private.toml and fill in your actual values.
# ~/.config/nix-config/ is outside the repo, so it's never part of the flake source.
# Build with: darwin-rebuild switch --flake .#HOST --impure
username = "user"

[email]
personal = "personal@example.com"
work = "work@example.com"

[git.userName]
personal = "personal-username"
work = "work-username"

[git.signingKey]
# Just the key name (e.g. "id_ed25519"), no path or .pub suffix.
personal = "id_ed25519"
work = "id_ed25519_work"

[atuin.sync]
# This host's Atuin CLI sync target. Omit on hosts that run without syncing.
address = "https://example.com"

[atuin.ai.client]
# Which AI bridge this host's CLI calls and the token it presents.
endpoint = "https://example.com"
# key = "..."   # token this client sends; must match the bridge's key

[atuin.ai.server]
# The Atuin AI bridge hosted on this host, plus its inference backend.
# Models advertised to clients; the first is the default. Clients may select
# any entry from the list. Empty => the bridge stays undeployed.
# models = ["model-id-1", "model-id-2"]
# upstream = "http://localhost:8001/v1"
# key = "..."          # AUTH_TOKEN the bridge requires from clients
# inferenceKey = "..." # token the bridge sends to the inference server
